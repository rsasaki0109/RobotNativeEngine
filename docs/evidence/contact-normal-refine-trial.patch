+fn velocity(
+    matrix: &DenseMatrix,
+    free: &[f64],
+    impulses: &[[f64; 3]],
+    config: &ContactSolverConfig,
+    i: usize,
+) -> [f64; 3] {
+    let impulse = &impulses[i];
+    let mut velocity = [0.0; 3];
+    for (axis, value) in velocity.iter_mut().enumerate() {
+        let row = 3 * i + axis;
+        *value = free[row]
+            + impulses
+                .iter()
+                .enumerate()
+                .map(|(j, p)| {
+                    (0..3)
+                        .map(|k| matrix.get(row, 3 * j + k) * p[k])
+                        .sum::<f64>()
+                })
+                .sum::<f64>();
+    }
+    let start = 3 * i;
+    let softness = config.regularization
+        * (0..3)
+            .map(|k| matrix.get(start + k, start + k))
+            .sum::<f64>()
+        / 3.0;
+    velocity[2] += softness * impulse[2];
+    velocity
+}
+
+pub(super) fn error(
+    matrix: &DenseMatrix,
+    free: &[f64],
+    friction: &[f64],
+    impulses: &[[f64; 3]],
+    config: &ContactSolverConfig,
+) -> f64 {
+    let it = config.tolerance_n_s;
+    let mut error = 0.0_f64;
+    for (i, p) in impulses.iter().enumerate() {
+        let v = velocity(matrix, free, impulses, config, i);
+        let mu = friction[i];
+        if !p.iter().all(|x| x.is_finite()) || !point_satisfied(*p, v, mu, it, f64::MAX) {
+            return f64::INFINITY;
+        }
+        error = error.max((-v[2]).max(0.0));
+        if p[2] > it {
+            error = error.max(v[2].abs());
+        }
+        let limit = mu * p[2].max(0.0);
+        if mu == 0.0 || limit <= it {
+            continue;
+        }
+        let slip = v[0].hypot(v[1]);
+        let tangent = p[0].hypot(p[1]);
+        let slack = it.max(CONE_TOLERANCE * limit);
+        let mut friction_error = slip;
+        if tangent > 0.0 && tangent >= limit - slack {
+            friction_error = friction_error
+                .min((v[0] + slip * p[0] / tangent).hypot(v[1] + slip * p[1] / tangent));
+        }
+        error = error.max(friction_error / std::f64::consts::SQRT_2);
+    }
+    error
+}
