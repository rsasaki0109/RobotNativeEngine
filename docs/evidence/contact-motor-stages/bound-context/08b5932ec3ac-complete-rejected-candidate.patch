+#[test]
+fn invalid_native_motor_samples_are_rejected_without_manufacturing_coverage() {
+    fn collect(
+        builder: &JointGenericOneBodyConstraintBuilder,
+        multibodies: &MultibodyJointSet,
+        constraint: JointGenericOneBodyConstraint,
+        duration: Real,
+        ordinal: usize,
+    ) -> Vec<InternalMotorImpulseSample> {
+        let mut samples = Vec::new();
+        builder.append_internal_motor_impulse_samples(
+            multibodies,
+            &[constraint],
+            0,
+            ordinal,
+            2,
+            duration,
+            &mut samples,
+        );
+        samples
+    }
+
+    // Exercise the actual native collector without solving an invalid motor.
+    let mut fixture = Fixture::new(false, 0.01, 2.0);
+    let link_id = *fixture
+        .multibody_joints
+        .rigid_body_link(fixture.child)
+        .unwrap();
+    let mut builder = JointGenericOneBodyConstraintBuilder::invalid();
+    let mut jacobians = na::DVector::zeros(0);
+    let mut j_id = 0;
+    let mut constraint_id = 0;
+    JointGenericVelocityOneBodyInternalConstraintBuilder::generate(
+        &fixture.multibody_joints,
+        &link_id,
+        &mut builder,
+        &mut j_id,
+        &mut jacobians,
+        &mut constraint_id,
+    );
+    assert_eq!(constraint_id, 1);
+    let valid = JointGenericOneBodyConstraint {
+        impulse: -0.2,
+        impulse_bounds: [-0.2, 0.2],
+        joint_id: usize::MAX,
+        writeback_id: WritebackId::Motor(0),
+        ..JointGenericOneBodyConstraint::invalid()
+    };
+    let qualified = collect(&builder, &fixture.multibody_joints, valid, 0.1, 0);
+    assert_eq!(qualified.len(), 1);
+    assert_eq!(impulse(qualified[0].slice.impulse), f64::from(0.2_f32));
+    for invalid in [Real::NAN, Real::INFINITY, Real::NEG_INFINITY] {
+        let constraint = JointGenericOneBodyConstraint {
+            impulse: invalid,
+            ..valid
+        };
+        assert!(collect(&builder, &fixture.multibody_joints, constraint, 0.1, 1).is_empty());
+    }
+    for duration in [Real::NAN, Real::INFINITY, Real::NEG_INFINITY, -0.1, 0.0] {
+        assert!(collect(&builder, &fixture.multibody_joints, valid, duration, 1).is_empty());
+    }
+    for bounds in [[-0.2, Real::NAN], [0.2, -0.2], [-0.1, 0.2]] {
+        let constraint = JointGenericOneBodyConstraint {
+            impulse_bounds: bounds,
+            ..valid
+        };
+        assert!(collect(&builder, &fixture.multibody_joints, constraint, 0.1, 1).is_empty());
+    }
+    for ceiling in [Real::NAN, -1.0, Real::NEG_INFINITY] {
+        let (multibody, id) = fixture.multibody_joints.get_mut(fixture.joint).unwrap();
+        multibody.link_mut(id).unwrap().joint.data.motors[JointAxis::LinX as usize].max_force =
+            ceiling;
+        assert!(collect(&builder, &fixture.multibody_joints, valid, 0.1, 1).is_empty());
+    }
+    let mut report = MultibodyMotorImpulseTelemetry::new(0.2);
+    report.ccd_partition_durations_s.push(f64::from(0.2_f32));
+    report.append(qualified);
+    report.finalize();
+    assert_eq!(report.motors.len(), 1);
+    assert!(!report.motors[0].full_step_coverage);
+    assert_eq!(report.motors[0].observed_solver_slice_count, 1);
+    assert_eq!(report.motors[0].slices[0].internal_slice_index, 0);
 }
 
