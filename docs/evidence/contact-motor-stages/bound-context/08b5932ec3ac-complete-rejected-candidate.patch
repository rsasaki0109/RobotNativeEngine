+#[test]
+fn internal_motor_diagonal_changes_only_the_force_based_model() {
+    let mut fixture = Fixture::new(false, 0.01, 2.0);
+    fixture.step();
+    let (multibody, id) = fixture.multibody_joints.get(fixture.joint).unwrap();
+    let link = multibody.link(id).unwrap();
+    let mut motor = link.joint().data.motors[JointAxis::LinX as usize];
+    let mut parameters = fixture.parameters;
+    parameters.dt /= 4.0;
+    for model in [MotorModel::ForceBased, MotorModel::AccelerationBased] {
+        motor.model = model;
+        let mut jacobians = na::DVector::zeros(2 * multibody.ndofs());
+        let mut constraints = [JointGenericOneBodyConstraint::invalid()];
+        let mut j_id = 0;
+        let mut insert_at = 0;
+        crate::dynamics::unit_joint_motor_constraint(
+            &parameters,
+            multibody,
+            link,
+            &motor,
+            0.0,
+            None,
+            0,
+            &mut j_id,
+            &mut jacobians,
+            &mut constraints,
+            &mut insert_at,
+        );
+        assert_eq!(insert_at, 1);
+        assert_eq!(j_id, 2 * multibody.ndofs());
+        let row = &constraints[0];
+        let w = jacobians[multibody.ndofs() + link.assembly_id];
+        assert!(w.is_finite() && w > 0.0);
+        match model {
+            MotorModel::ForceBased => {
+                assert!(row.cfm_gain.is_finite() && row.cfm_gain > 0.0);
+                assert_eq!(row.cfm_coeff, 0.0);
+                assert_eq!(
+                    row.inv_lhs.to_bits(),
+                    crate::utils::inv(w + row.cfm_gain).to_bits()
+                );
+                assert!(row.inv_lhs < crate::utils::inv(w));
+            }
+            MotorModel::AccelerationBased => {
+                assert_eq!(row.cfm_gain, 0.0);
+                assert!(row.cfm_coeff.is_finite() && row.cfm_coeff > 0.0);
+                // Keep the pre-existing internal AccelerationBased arithmetic.
+                assert_eq!(row.inv_lhs.to_bits(), crate::utils::inv(w).to_bits());
+            }
+        }
+    }
+}
