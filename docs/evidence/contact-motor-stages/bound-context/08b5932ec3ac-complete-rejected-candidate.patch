+#[test]
+fn force_based_first_slice_matches_the_projected_fixed_point_for_both_signs() {
+    for (stiffness, damping) in [(300.0, 12.0), (250.0, 8.0)] {
+        for target in [-0.001, 0.001] {
+            let mut fixture = Fixture::new(true, target, 2.0);
+            fixture.parameters.num_solver_iterations = NonZeroUsize::new(32).unwrap();
+            fixture.parameters.num_internal_pgs_iterations = 1;
+            fixture.parameters.num_internal_stabilization_iterations = 2;
+            let (multibody, id) = fixture.multibody_joints.get_mut(fixture.joint).unwrap();
+            let motor =
+                &mut multibody.link_mut(id).unwrap().joint.data.motors[JointAxis::AngX as usize];
+            motor.stiffness = stiffness;
+            motor.damping = damping;
+            fixture.bodies[fixture.child]
+                .recompute_mass_properties_from_colliders(&fixture.colliders);
+            let inertia = fixture.bodies[fixture.child]
+                .mass_properties()
+                .effective_angular_inertia()
+                .m11;
+            approx::assert_relative_eq!(inertia, 0.004, max_relative = 1.0e-6);
+            assert_eq!(fixture.joint_velocity(), 0.0);
+            fixture
+                .pipeline
+                .set_multibody_motor_impulse_telemetry_enabled(true);
+            fixture.step();
+            let record = fixture.record();
+            assert!(record.full_step_coverage);
+            assert_eq!(record.observed_solver_slice_count, 32);
+            assert!(fixture.joint_velocity().is_finite());
+            assert!(record
+                .slices
+                .iter()
+                .all(|slice| impulse(slice.impulse).is_finite()));
+            let first = &record.slices[0];
+            assert_eq!(first.ccd_partition_index, 0);
+            assert_eq!(first.internal_slice_index, 0);
+            assert!(first.duration_s.is_finite() && first.duration_s > 0.0);
+
+            // Independently evaluate the fixed point with native coefficients.
+            // The isotropic, centered sphere has w = 1 / Ixx in this isolated row.
+            // This checks the final first-slice impulse, including stabilization.
+            let h = first.duration_s as Real;
+            let a = stiffness * (1.0 / (h * stiffness + damping));
+            let g = 1.0 / (h * h * stiffness + h * damping);
+            let w = 1.0 / inertia;
+            let rhs = (0.0 - target) * a;
+            let bound = 2.0 * h;
+            let expected = (-f64::from(rhs) / (f64::from(w) + f64::from(g)))
+                .clamp(-f64::from(bound), f64::from(bound));
+            let actual = impulse(first.impulse);
+            let tolerance = 1.0e-8_f64.max(0.01 * expected.abs());
+            assert!(
+                (actual - expected).abs() <= tolerance,
+                "k={stiffness}, d={damping}, target={target}, actual={actual}, expected={expected}, tolerance={tolerance}"
+            );
+            assert!(actual * f64::from(target) > 0.0);
+        }
+    }
+}
