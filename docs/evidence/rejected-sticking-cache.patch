+/// Fixed local matrix and the RHS-independent parts of Cramer's rule.
+/// Keep numerator arithmetic in the original order: using an inverse matrix
+/// would reassociate additions and change subsequent contact iterations.
+struct ContactBlock {
+    matrix: [[f64; 3]; 3],
+    cofactors: [f64; 3],
+    determinant: Option<f64>,
+}
+
+impl ContactBlock {
+    fn new(g: [[f64; 3]; 3]) -> Self {
+        let cofactors = [
+            g[1][1] * g[2][2] - g[1][2] * g[2][1],
+            g[1][0] * g[2][2] - g[1][2] * g[2][0],
+            g[1][0] * g[2][1] - g[1][1] * g[2][0],
+        ];
+        let det = g[0][0] * cofactors[0] - g[0][1] * cofactors[1] + g[0][2] * cofactors[2];
+        let singular =
+            det.abs() <= f64::EPSILON * (g[0][0].abs() + g[1][1].abs() + g[2][2].abs()).powi(3);
+        Self {
+            matrix: g,
+            cofactors,
+            determinant: (!singular).then_some(det),
+        }
+    }
+
+    fn solve_sticking(&self, rhs: [f64; 3]) -> Option<[f64; 3]> {
+        let det = self.determinant?;
+        let g = &self.matrix;
+        Some([
+            (rhs[0] * self.cofactors[0] - g[0][1] * (rhs[1] * g[2][2] - g[1][2] * rhs[2])
+                + g[0][2] * (rhs[1] * g[2][1] - g[1][1] * rhs[2]))
+                / det,
+            (g[0][0] * (rhs[1] * g[2][2] - g[1][2] * rhs[2]) - rhs[0] * self.cofactors[1]
+                + g[0][2] * (g[1][0] * rhs[2] - rhs[1] * g[2][0]))
+                / det,
+            (g[0][0] * (g[1][1] * rhs[2] - rhs[1] * g[2][1])
+                - g[0][1] * (g[1][0] * rhs[2] - rhs[1] * g[2][0])
+                + rhs[0] * self.cofactors[2])
+                / det,
+        ])
+    }
+}
